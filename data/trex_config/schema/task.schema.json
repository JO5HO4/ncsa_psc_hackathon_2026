{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRExFitter configuration task",
  "type": "object",
  "required": ["schema_version", "id", "task_type", "split", "config_format", "physics_goal", "fixture", "initial_config", "expected"],
  "properties": {
    "schema_version": {"const": "v0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "task_type": {"enum": ["repair", "synthesis", "multi_edit_repair"]},
    "config_format": {"const": "trexfitter-config"},
    "split": {"enum": ["train", "validation", "test"]},
    "physics_goal": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "fixture": {
      "type": "object",
      "required": ["id", "config_path", "sha256"],
      "properties": {
        "id": {"type": "string"},
        "config_path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[^\\n]+\\.config$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "initial_config": {"type": "string"},
    "diagnostics": {"type": "array", "items": {"type": "object"}},
    "expected": {
      "type": "object",
      "required": ["reference_patch", "validation"],
      "properties": {
        "reference_patch": {"type": "string"},
        "validation": {"type": "object"},
        "metric": {"type": "object"}
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
