{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ncsa-psc-hackathon/root-io-task-v0.1.json",
  "title": "Canonical ROOT-I/O inspection task",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "dataset_family",
    "task_type",
    "split",
    "user_request",
    "fixture",
    "allowed_tools",
    "trajectory",
    "expected",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "v0.1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "dataset_family": {"const": "root_io"},
    "task_type": {
      "enum": ["object_inventory", "tree_schema", "branch_summary", "file_summary"]
    },
    "split": {"enum": ["train", "validation", "test"]},
    "user_request": {"type": "string", "minLength": 1},
    "fixture": {
      "type": "object",
      "required": ["id", "path", "sha256", "source", "revision"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\n]+\\.root$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["list_root_objects", "describe_tree", "summarize_branch"]
      }
    },
    "trajectory": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/turn"}
    },
    "expected": {
      "type": "object",
      "required": ["required_facts", "reference_answer"],
      "properties": {
        "required_facts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden_claims": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "reference_answer": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["difficulty", "author", "review_status"],
      "properties": {
        "difficulty": {"enum": ["introductory", "intermediate", "advanced"]},
        "author": {"type": "string", "minLength": 1},
        "reviewer": {"type": ["string", "null"]},
        "review_status": {"enum": ["draft", "reviewed"]},
        "semantic_sources": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "turn": {
      "type": "object",
      "required": ["role"],
      "properties": {
        "role": {"enum": ["user", "assistant", "tool"]},
        "content": {"type": "string"},
        "tool_call": {
          "type": "object",
          "required": ["id", "name", "arguments"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "name": {
              "enum": ["list_root_objects", "describe_tree", "summarize_branch"]
            },
            "arguments": {"type": "object"}
          },
          "additionalProperties": false
        },
        "tool_call_id": {"type": "string", "minLength": 1},
        "result": {"type": "object"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"role": {"const": "user"}}},
          "then": {"required": ["content"]}
        },
        {
          "if": {"properties": {"role": {"const": "assistant"}}},
          "then": {
            "oneOf": [
              {"required": ["content"], "not": {"required": ["tool_call"]}},
              {"required": ["tool_call"], "not": {"required": ["content"]}}
            ]
          }
        },
        {
          "if": {"properties": {"role": {"const": "tool"}}},
          "then": {"required": ["tool_call_id", "result"]}
        }
      ]
    }
  },
  "additionalProperties": false
}
